{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "pi-mcp-adapter": ["./types/pi-mcp-adapter.d.ts"]
    }
  },
  "include": ["*.ts", "**/*.ts"]
}
